#recipe.id, recipe_ing.recipe, recipe.name should be indexed for speed

SELECT 
    r.name AS recipe_name,
    r.id AS recipe_id,
    i.name AS ingredient_name,
    i.id as ingredient_id,
    ri.quantity,
    ri.units
FROM 
    recipe r JOIN recipe_ing ri ON r.id = ri.recipe_id JOIN ingredients i ON ri.ingredient_id = i.id
ORDER BY 
    r.id,i.id
----------------------------------
SELECT 
    r.name AS recipe_name,
    r.id AS recipe_id,
    i.name AS ingredient_name,
    i.id as ingredient_id,
    ri.quantity,
    ri.units
FROM 
    recipe r JOIN recipe_ing ri ON r.id = ri.recipe_id JOIN ingredients i ON ri.ingredient_id = i.id
    where r.viewable = true
ORDER BY 
    r.id,i.id

